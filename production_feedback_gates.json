{
  "policy": "living_tapestries_v2_feedback",
  "source_of_truth": "narration_waveform_and_authoritative_episode_json",
  "lifecycle_monitoring": {
    "enabled": true,
    "continue_until_terminal": true,
    "terminal_states": ["complete", "stopped", "blocked"],
    "stop_only_on_explicit_interrupt_or_block": true,
    "do_not_stop_on_turn_boundary": true,
    "heartbeat_interval_seconds": 60,
    "required_phases": ["narration", "timeline", "scene_render", "scene_merge", "caption_encode", "audio_mux", "qa", "delivery"],
    "require_active_child_process_check": true,
    "require_output_growth_check_during_encode": true,
    "forbid_completion_report_while_process_active": true,
    "failure_message": "long-running production jobs must report a current phase and heartbeat; never report completion while a child encoder or QA process remains active"
  },
  "failure_prevention_gates": {
    "enabled": true,
    "hard_gate": true,
    "continue_until_all_pass": true,
    "artifact_identity": {
      "required": true,
      "require_single_delivery_bundle": true,
      "require_sha256_manifest": true,
      "require_same_render_id_across_video_srt_qa_visual_gates": true
    },
    "latest_render_match": {
      "required": true,
      "reject_stale_drive_file": true,
      "require_local_output_newer_than_previous_delivery": true,
      "require_uploaded_filename_to_include_render_id": true
    },
    "drive_delivery": {
      "required": true,
      "require_upload_success": true,
      "require_drive_url": true,
      "require_uploaded_name_match": true,
      "require_uploaded_sha256_match": true,
      "preserve_previous_files_until_verified": true
    },
    "diagnostic_commands": {
      "required": true,
      "fail_on_nonzero_exit": true,
      "fail_on_missing_output": true,
      "do_not_report_unverified_results": true
    },
    "success_claim": {
      "required": true,
      "requires_lifecycle_complete": true,
      "requires_timing_qa_pass": true,
      "requires_visual_gates_pass": true,
      "requires_drive_delivery_pass": true
    }
  },
  "camera": {
    "default_direction": "right",
    "max_normalized_travel_per_second": 0.078,
    "require_smooth_continuous_path": true,
    "forbid_shake": true,
    "forbid_hard_crop_changes": true,
    "forbid_arbitrary_hold_timers": true
  },
  "scenes": {
    "required_visual_beats": 3,
    "transition_max_black_luma": 2.0,
    "transition_min_progression_diff": 0.05,
    "require_actual_rendered_progression": true,
    "audience_emotion_gate": {
      "enabled": true,
      "hard_gate": true,
      "required_fields": ["intended_emotion", "visual_evidence", "emotional_turn"],
      "require_emotion_specific_to_scene": true,
      "require_visual_evidence_for_emotion": true,
      "failure_message": "each scene must state what the audience should feel, what visible details create that feeling, and how the emotion changes across the scene"
    }
  },
  "artwork": {
    "culture_period_style_defaults": [
      {
        "id": "byzantine_ottoman_eastern_mediterranean",
        "enabled": true,
        "trigger_terms": ["byzantine", "ottoman", "constantinople", "eastern mediterranean", "1453"],
        "style_direction": "Byzantine civic mosaic meets Ottoman miniature panorama, gold tesserae, cobalt walls",
        "required_style_terms": ["byzantine civic mosaic", "ottoman miniature panorama", "gold tesserae", "cobalt walls"],
        "preserve_explicit_source_style": false,
        "failure_message": "Byzantine/Ottoman eastern-Mediterranean stories must use the Constantinople visual language unless this policy is explicitly revised"
      },
      {
        "id": "indian_myth_folklore_style_reuse",
        "enabled": true,
        "trigger_terms": ["indian mythology", "indian folklore", "ancient india", "mahabharata", "ramayana", "nala", "damayanti", "savitri"],
        "approved_reuse_direction": "Rajput miniature illuminated folio, forest greens, pink sandstone palaces, golden patterns",
        "mode": "approved_reuse_not_mandatory",
        "historical_rule": "For historically grounded Indian stories, derive the visual medium, clothing, architecture, weapons, palette, and inscriptions from the documented culture and period; do not inherit the Rajput miniature direction automatically."
      }
    ],
    "require_horizontal_panorama": true,
    "required_asset_prefix": "H",
    "allow_legacy_portrait_fallback": false,
    "minimum_width_pixels": 2500,
    "minimum_height_pixels": 1600,
    "require_culture_specific_style": true,
    "require_distinct_adjacent_scene_storytelling": true,
    "culture_direction_source": "authoritative episode JSON civilization, art_style, palette, image_prompt, and visual_progression",
    "museum_quality_art_direction": true,
    "intra_scene_seam_hard_gate": true,
    "major_religious_imagery_gate": {
      "enabled": true,
      "hard_gate": true,
      "forbidden_terms": [
        "jesus", "christ", "mary", "virgin mary", "saint", "saints",
        "devotional icon", "religious icon", "religious medallion",
        "saint portrait", "holy family", "allah", "muhammad", "prophet muhammad",
        "buddha statue", "hindu deity", "ganesha", "shiva", "krishna"
      ],
      "failure_message": "major-religion figures and devotional portraits or medallions are forbidden; standalone symbols, architecture, and minor cultural motifs are allowed"
    },
    "medieval_european_style_gate": {
      "enabled": true,
      "minimum_episode_number": 1,
      "trigger_terms": [
        "arthurian", "medieval europe", "medieval britain", "british", "welsh", "irish",
        "anglo-saxon", "saxon", "frankish", "german", "holy roman empire", "norse",
        "viking", "celtic", "slavic", "french", "english"
      ],
      "allowed_style_families": [
        "illuminated manuscript",
        "french gothic illuminated manuscript",
        "painted parchment narrative art",
        "english tudor manuscript miniature",
        "narrative tapestry",
        "gothic fresco",
        "gothic panel painting",
        "northern renaissance realism",
        "pre-raphaelite oil painting",
        "restrained historical oil painting"
      ],
      "style_direction_note": "Select one culturally and historically appropriate family from the allowed list. Woodcut and block-print styles are not allowed.",
      "required_terms": [
        "pre-raphaelite", "medieval realism", "psychological depth", "natural human faces",
        "historically informed fabrics", "weathered stone architecture", "atmospheric light",
        "muted crimson", "forest green", "aged bronze", "tragic grandeur",
        "complex multi-figure composition", "painterly brushwork", "noble but imperfect",
        "avoid excessive gilding", "glossy fantasy", "plastic faces", "decorative clutter"
      ],
      "fail_on_missing_direction": true,
      "fail_on_unapproved_style_family": true
    },
    "forbidden_style_terms": ["cartoon", "cartoony", "comic-book", "glossy 3d", "glossy fantasy poster", "generic stock illustration"]
  },
  "scene_contrast": {
    "enabled": true,
    "sample_fractions": [0.08, 0.50, 0.92],
    "minimum_pair_mean_abs_diff": 4.0,
    "minimum_distinct_samples": 2,
    "failure_message": "adjacent scenes are visually too similar; regenerate the deficient scene with a distinct narrative composition"
  },
  "line_artifact_review": {
    "enabled": true,
    "reviewer": "line_artifact_agent",
    "scope": "visible intra-scene vertical joins and panorama seams only",
    "sample_fractions": [0.2, 0.5, 0.8, 0.95],
    "sample_interval_seconds": 0.5,
    "max_mean_edge": 52.0,
    "min_continuity": 0.70,
    "fail_on_flagged_sample": true,
    "hard_gate": true,
    "fail_on_any_flagged_sample": true
  },
  "provenance": {
    "required_after_what_if": true,
    "must_be_derived_from_civilization": true,
    "dedupe_repeated_terms": true,
    "dedupe_terms": ["mythology", "legend", "tradition", "folklore", "historical account", "epic"],
    "ordinary_duplicate_words": "review_only",
    "recognized_markers": ["mythology", "legend", "tradition", "century", "historical account", "epic"]
  },
  "rendered_caption_text": {
    "reject_mojibake": true,
    "forbidden_sequences": ["â€™", "â€œ", "â€", "Ã¢", "Ã‚"]
  },
  "prose": {
    "smooth_character_intro_joins": true,
    "reject_awkward_intro_joins": true,
    "review_sentence_joins": true
  },
  "name_spelling_review": {
    "enabled": true,
    "reviewer": "name_spelling_agent",
    "fail_on_misspelling": true,
    "common_misspellings": {
      "Mehmed": ["Mehmet", "Mehmedh", "Mahmed"],
      "Mitsuhide": ["Mitsuhidi", "Mitsuhideh"],
      "Osiris": ["Oziris", "Osirys"]
    },
    "accepted_aliases": {
      "Constantine XI": ["Constantine the Eleventh"]
    }
  },
  "historical_scene_review": {
    "enabled": true,
    "reviewer": "historical_scene_agent",
    "fail_on_declared_contradiction": true,
    "missing_constraints_status": "REVIEW"
  },
  "wording_review": {
    "enabled": true,
    "reviewer": "wording_agent",
    "max_year_repeats": 1,
    "max_civilization_label_repeats": 1,
    "awkward_phrase_patterns": [
      {
        "pattern": "\\bwe would not share today\\b",
        "message": "anachronistic first-person phrasing sounds editorial rather than narrated"
      },
      {
        "pattern": "\\b(?:those|these) choices reflected theories about .*\\bwe\\b",
        "message": "abstract gate-inserted clause needs natural historical narration"
      }
    ],
    "fail_on_findings": true,
    "smooth_safe_gate_insertions_before_tts": true
  },
  "word_timing": {
    "require_nonempty_scene_artifacts": true,
    "check_internal_pauses": true,
    "warn_internal_gap_seconds": 0.35,
    "fail_internal_gap_seconds": 0.5,
    "sentence_terminal_punctuation": [".", "!", "?"],
    "pause_justifying_punctuation": [",", ";", ":", ".", "!", "?"]
  },
  "natural_speech_review": {
    "required": true,
    "review_merged_words": true,
    "review_clause_separation": true,
    "review_provenance_flow": true,
    "review_mojibake_and_encoding": true,
    "review_live_playback_when_available": true
  },
  "captions": {
    "allow_overlap_seconds": 0.0,
    "speech_boundary_tolerance_seconds": 0.08,
    "must_follow_narration": true,
    "must_not_linger_in_authored_silence": true
  },
  "audio": {
    "narration_is_master_clock": true,
    "audition_required_when_available": true,
    "require_mix_manifest": true,
    "require_narration_mix_hash_match": true,
    "require_separate_stems_for_delivery": false
  },
  "delivery_integrity": {
    "require_timeline_asset_paths_exist": true,
    "require_srt_match_timeline_captions": true,
    "require_cache_text_match_effective_tts": true,
    "require_holistic_review": true,
    "review_roles": ["procedural_pipeline_audit", "name_spelling_agent", "historical_scene_agent", "wording_agent", "natural_speech_review", "adversarial_render_review"]
  },
  "multi_agent_review": {
    "enabled": true,
    "procedural_pipeline_audit": {"enabled": true, "hard_gate": true},
    "name_spelling_agent": {"enabled": true, "hard_gate": true},
    "historical_scene_agent": {"enabled": true, "hard_gate_on_declared_contradiction": true},
    "wording_agent": {"enabled": true, "hard_gate": true},
    "natural_speech_review": {"enabled": true, "hard_gate": true, "auditory_playback_required_when_available": true},
    "adversarial_render_review": {"enabled": true, "hard_gate": true},
    "line_artifact_agent": {"enabled": true, "hard_gate": true}
  },
  "anatomy_review": {
    "enabled": true,
    "reviewer": "anatomy_artifact_agent",
    "hard_gate": true,
    "required_samples_per_scene": 3,
    "required_verdict": "PASS",
    "forbidden_findings": [
      "extra limb", "duplicated limb", "merged figure", "melted anatomy",
        "duplicated face", "impossible joint", "fused hand", "malformed body",
        "rotated head", "180 degree head", "unnatural neck", "reversed face",
        "twisted face", "dislocated head"
    ]
  },
  "pronunciation": {
    "fallback": "english_source_spelling",
    "preserve_caption_spelling": true,
    "reject_empty_overrides": true,
    "reject_letter_by_letter_overrides": true,
    "audit_proper_names": true
  },
  "character_intros": {
    "enabled": true,
    "max_inserted_words": 6,
    "max_new_intro_per_scene": 1,
    "never_repeat": true,
    "timing_authority": "narration_waveform",
    "spoiler_free": true,
    "forbidden_outcome_terms": ["survivor", "dies", "dead", "murdered", "killed", "returns", "wins", "loses", "defeated"]
  }
}
