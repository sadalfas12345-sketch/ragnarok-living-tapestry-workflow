    "phrases": [
      {
        "scene": "S01",
        "text": "Damayanti chose King Nala despite the gods appearing among her suitors.",
        "start": 0.46,
        "end": 5.24
      },
      {
        "scene": "S01",
        "text": "Their union began with devotion, but happiness would not protect them from disaster.",
        "start": 5.78,
        "end": 11.08
      },
      {
        "scene": "S02",
        "text": "Nala fell under a ruinous influence and lost his kingdom at dice to his brother Pushkara.",
        "start": 12.18,
        "end": 19.14
      },
      {
        "scene": "S02",
        "text": "With power gone, the couple entered the wilderness.",
        "start": 19.14,
        "end": 21.96
      },
      {
        "scene": "S03",
        "text": "Exhausted and ashamed, Nala abandoned Damayanti while she slept.",
        "start": 23.28,
        "end": 28.4
      },
      {
        "scene": "S03",
        "text": "She woke alone in a forest full of danger and set out to find him.",
        "start": 28.4,
        "end": 33.694
      },
      {
        "scene": "S04",
        "text": "Nala wandered in disguise, learned new skills, and struggled with regret.",
        "start": 35.06,
        "end": 40.18
      },
      {
        "scene": "S04",
        "text": "Damayanti refused to accept that their story was finished.",
        "start": 41.02,
        "end": 44.48
      },
      {
        "scene": "S05",
        "text": "Through ingenuity and careful tests, Damayanti discovered Nala’s whereabouts.",
        "start": 45.66,
        "end": 51.28
      },
      {
        "scene": "S05",
        "text": "The two could finally speak after years of fear and separation.",
        "start": 52.06,
        "end": 56.22
      },
      {
        "scene": "S06",
        "text": "Nala recovered his position, but the deeper victory was their reunion.",
        "start": 57.502,
        "end": 62.58
      },
      {
        "scene": "S06",
        "text": "The tale understands that pride can destroy what misfortune alone could not.",
        "start": 63.38,
        "end": 68.209
      }
    ],
