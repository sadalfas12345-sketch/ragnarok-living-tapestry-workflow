    "phrases": [
      {
        "scene": "S01",
        "text": "Osiris ruled as a divine king.",
        "start": 0.0,
        "end": 2.96
      },
      {
        "scene": "S01",
        "text": "His brother Seth became his enemy and, in a familiar telling, tricked him into a coffin made to fit him exactly.",
        "start": 3.46,
        "end": 11.6
      },
      {
        "scene": "S02",
        "text": "The chest was sealed and carried away.",
        "start": 12.46,
        "end": 14.98
      },
      {
        "scene": "S02",
        "text": "Isis searched desperately for her husband, following traces of him across river and shore.",
        "start": 15.78,
        "end": 22.168
      },
      {
        "scene": "S03",
        "text": "In one version, Seth tore Osiris apart and scattered the pieces.",
        "start": 23.12,
        "end": 28.44
      },
      {
        "scene": "S03",
        "text": "Isis gathered what she could, helped by divine allies and funerary rites.",
        "start": 28.44,
        "end": 34.694
      },
      {
        "scene": "S04",
        "text": "Osiris was restored in a form that belonged to the realm of the dead.",
        "start": 35.86,
        "end": 40.52
      },
      {
        "scene": "S04",
        "text": "He would judge and rule there, but not simply return to ordinary life.",
        "start": 41.12,
        "end": 45.939
      },
      {
        "scene": "S05",
        "text": "Their son Horus confronted Seth over kingship.",
        "start": 47.06,
        "end": 50.28
      },
      {
        "scene": "S05",
        "text": "The conflict became a struggle over rightful authority, inheritance and the order of the world.",
        "start": 50.28,
        "end": 57.778
      },
      {
        "scene": "S06",
        "text": "Osiris lost his earthly kingdom, yet became central to hopes of life beyond death.",
        "start": 59.24,
        "end": 65.74
      },
      {
        "scene": "S06",
        "text": "His murder transformed into an Egyptian story about continuity.",
        "start": 66.32,
        "end": 70.48
      }
    ],
