    "phrases": [
      {
        "scene": "S01",
        "text": "A father and son were trapped on Crete.",
        "start": 0.0,
        "end": 3.36
      },
      {
        "scene": "S01",
        "text": "Daedalus, the brilliant craftsman, could build almost anything, but he could not persuade King Minos to let them go.",
        "start": 3.5,
        "end": 11.854
      },
      {
        "scene": "S02",
        "text": "So he fashioned wings from feathers and wax.",
        "start": 12.7,
        "end": 15.46
      },
      {
        "scene": "S02",
        "text": "The sky, which no guard could patrol, became their path out of captivity.",
        "start": 16.08,
        "end": 21.32
      },
      {
        "scene": "S03",
        "text": "Daedalus warned his son to fly neither too low, where sea spray would weigh down the feathers, nor too high, where the sun would soften their bonds.",
        "start": 22.62,
        "end": 32.12
      },
      {
        "scene": "S04",
        "text": "At first they soared together.",
        "start": 33.3,
        "end": 35.16
      },
      {
        "scene": "S04",
        "text": "Then Icarus climbed, overwhelmed by the freedom of flying above every wall he had ever known.",
        "start": 35.62,
        "end": 42.42
      },
      {
        "scene": "S05",
        "text": "Heat loosened the wax.",
        "start": 43.6,
        "end": 45.0
      },
      {
        "scene": "S05",
        "text": "Feathers scattered.",
        "start": 45.8,
        "end": 46.5
      },
      {
        "scene": "S05",
        "text": "Icarus plunged toward the sea as his father called for him, unable to undo what had happened.",
        "start": 47.38,
        "end": 53.508
      },
      {
        "scene": "S06",
        "text": "Daedalus survived, but freedom carried a cost he had never meant to pay.",
        "start": 54.76,
        "end": 60.12
      },
      {
        "scene": "S06",
        "text": "The story is not simply about ambition; it is about exhilaration outrunning judgment.",
        "start": 60.62,
        "end": 66.22
      }
    ],
