    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "Orpheus could make the world listen when he sang.",
        "start": 0.0,
        "end": 3.28
      },
      {
        "scene": "S01",
        "text": "But when his wife Eurydice died, music could not reach her where she had gone.",
        "start": 3.66,
        "end": 8.66
      },
      {
        "scene": "S02",
        "text": "He descended into the underworld with only his lyre.",
        "start": 9.52,
        "end": 12.92
      },
      {
        "scene": "S02",
        "text": "Even the dead paused.",
        "start": 13.48,
        "end": 14.74
      },
      {
        "scene": "S02",
        "text": "The rulers below listened to his grief and offered a terrible bargain.",
        "start": 15.34,
        "end": 20.115
      },
      {
        "scene": "S03",
        "text": "Eurydice could follow him back toward daylight.",
        "start": 21.22,
        "end": 23.8
      },
      {
        "scene": "S03",
        "text": "But until both had left the realm of death, Orpheus must not turn to look at her.",
        "start": 23.8,
        "end": 30.061
      },
      {
        "scene": "S04",
        "text": "He walked ahead and heard her footsteps behind him.",
        "start": 31.22,
        "end": 34.76
      },
      {
        "scene": "S04",
        "text": "Near the exit, afraid she was not truly there, he looked back.",
        "start": 35.12,
        "end": 40.0
      },
      {
        "scene": "S05",
        "text": "He saw Eurydice only for an instant.",
        "start": 41.1,
        "end": 43.54
      },
      {
        "scene": "S05",
        "text": "Then she faded into the shadows, lost again, and the path behind him closed.",
        "start": 44.12,
        "end": 50.3
      },
      {
        "scene": "S06",
        "text": "A voice powerful enough to move the dead could not undo one moment of fear.",
        "start": 51.457,
        "end": 57.16
      },
      {
        "scene": "S06",
        "text": "Orpheus returned alone, carrying the song that had almost worked.",
        "start": 57.86,
        "end": 62.06
      }
    ],
