    "phrases": [
      {
        "scene": "S01",
        "text": "Sun Wukong rose from a stone egg and became king of the monkeys.",
        "start": 0.0,
        "end": 5.04
      },
      {
        "scene": "S01",
        "text": "But victories on earth were not enough; he wanted recognition from Heaven itself.",
        "start": 5.7,
        "end": 11.06
      },
      {
        "scene": "S02",
        "text": "The celestial court gave him a minor post, thinking it would contain him.",
        "start": 12.04,
        "end": 17.02
      },
      {
        "scene": "S02",
        "text": "When he learned how little the title meant, the Monkey King rebelled.",
        "start": 17.34,
        "end": 21.64
      },
      {
        "scene": "S03",
        "text": "He stole celestial peaches, disrupted a banquet, and survived attempts to destroy him.",
        "start": 22.7,
        "end": 29.22
      },
      {
        "scene": "S03",
        "text": "Even heavenly troops struggled to bring him to heel.",
        "start": 29.22,
        "end": 32.855
      },
      {
        "scene": "S04",
        "text": "At last the Buddha challenged him to escape the palm of his hand.",
        "start": 33.96,
        "end": 38.46
      },
      {
        "scene": "S04",
        "text": "Wukong leapt to what he thought was the end of the universe.",
        "start": 39.0,
        "end": 42.2
      },
      {
        "scene": "S05",
        "text": "The pillars he marked were only fingers.",
        "start": 43.34,
        "end": 45.82
      },
      {
        "scene": "S05",
        "text": "His limitless journey had never left the Buddha’s palm.",
        "start": 46.5,
        "end": 50.34
      },
      {
        "scene": "S05",
        "text": "A mountain then held him fast.",
        "start": 50.96,
        "end": 52.88
      },
      {
        "scene": "S06",
        "text": "His story did not end in defeat.",
        "start": 54.3,
        "end": 56.48
      },
      {
        "scene": "S06",
        "text": "Later, the same unruly strength would be redirected into a pilgrimage, where power had to learn restraint.",
        "start": 56.48,
        "end": 64.92
      }
    ],
