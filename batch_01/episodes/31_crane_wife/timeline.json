    "phrases": [
      {
        "scene": "S01",
        "text": "What if the person you loved was destroying herself to keep you warm?",
        "start": 0.0,
        "end": 4.24
      },
      {
        "scene": "S01",
        "text": "In a Japanese folktale, a poor man finds a white crane caught in a trap.",
        "start": 4.7,
        "end": 10.04
      },
      {
        "scene": "S01",
        "text": "He frees its bloodied leg and watches it vanish into falling snow.",
        "start": 10.64,
        "end": 14.96
      },
      {
        "scene": "S02",
        "text": "Days later, a young woman arrives at his cottage in the winter dusk.",
        "start": 15.78,
        "end": 20.6
      },
      {
        "scene": "S02",
        "text": "She asks to stay, and in time they marry.",
        "start": 21.28,
        "end": 24.14
      },
      {
        "scene": "S02",
        "text": "Their home has little food and no fine clothing, but for a while, they are happy.",
        "start": 24.14,
        "end": 29.994
      },
      {
        "scene": "S03",
        "text": "When money runs out, the wife offers to weave a beautiful cloth.",
        "start": 31.14,
        "end": 35.72
      },
      {
        "scene": "S03",
        "text": "She asks only one thing: he must never look inside while she works.",
        "start": 36.36,
        "end": 41.16
      },
      {
        "scene": "S03",
        "text": "Behind the closed door, the loom moves for nights.",
        "start": 41.82,
        "end": 44.84
      },
      {
        "scene": "S03",
        "text": "At dawn, she emerges weak, holding silk unlike anything he has seen.",
        "start": 45.58,
        "end": 51.78
      },
      {
        "scene": "S04",
        "text": "He sells the cloth for a fortune.",
        "start": 52.492,
        "end": 54.88
      },
      {
        "scene": "S04",
        "text": "Soon another buyer offers even more, and the husband asks her to weave again.",
        "start": 55.72,
        "end": 60.76
      },
      {
        "scene": "S04",
        "text": "She agrees, though her face is drained.",
        "start": 61.38,
        "end": 64.34
      },
      {
        "scene": "S04",
        "text": "The loom begins behind the door.",
        "start": 64.98,
        "end": 67.04
      },
      {
        "scene": "S04",
        "text": "This time, fear and curiosity drive him to the keyhole.",
        "start": 67.62,
        "end": 71.895
      },
      {
        "scene": "S05",
        "text": "Inside, there is no woman at the loom.",
        "start": 73.0,
        "end": 75.68
      },
      {
        "scene": "S05",
        "text": "A white crane is pulling feathers from its own body and weaving them into cloth.",
        "start": 75.68,
        "end": 81.78
      },
      {
        "scene": "S05",
        "text": "The man recognizes the bird he once saved.",
        "start": 82.48,
        "end": 85.58
      },
      {
        "scene": "S05",
        "text": "She sees him in the doorway.",
        "start": 86.26,
        "end": 87.68
      },
      {
        "scene": "S05",
        "text": "The promise that kept them together is broken.",
        "start": 88.46,
        "end": 91.12
      },
      {
        "scene": "S06",
        "text": "The crane tells him she can no longer remain as his wife.",
        "start": 92.36,
        "end": 95.88
      },
      {
        "scene": "S06",
        "text": "In this telling, she spreads her injured wings and flies into the winter sky.",
        "start": 96.42,
        "end": 102.46
      },
      {
        "scene": "S06",
        "text": "He runs after her, too late.",
        "start": 103.02,
        "end": 104.76
      },
      {
        "scene": "S06",
        "text": "Back in the cottage, her unfinished cloth lies beside a bowl meant for two.",
        "start": 104.76,
        "end": 110.941
      }
    ],
