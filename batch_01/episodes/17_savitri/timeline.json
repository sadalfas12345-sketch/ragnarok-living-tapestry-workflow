    "phrases": [
      {
        "scene": "S01",
        "text": "Savitri chose Satyavan as her husband, even after learning that he was fated to die within a year.",
        "start": 0.0,
        "end": 7.4
      },
      {
        "scene": "S01",
        "text": "She married him without abandoning her choice.",
        "start": 7.96,
        "end": 10.728
      },
      {
        "scene": "S02",
        "text": "When the day arrived, Satyavan collapsed while gathering wood in the forest.",
        "start": 11.5,
        "end": 16.46
      },
      {
        "scene": "S02",
        "text": "Yama, lord of death, came to claim his life.",
        "start": 17.16,
        "end": 20.602
      },
      {
        "scene": "S03",
        "text": "Savitri followed Yama along the road away from the living.",
        "start": 21.68,
        "end": 25.56
      },
      {
        "scene": "S03",
        "text": "He told her to return, but she answered with wisdom and would not leave.",
        "start": 25.56,
        "end": 31.577
      },
      {
        "scene": "S04",
        "text": "Impressed, Yama granted her boons—except Satyavan’s life.",
        "start": 32.9,
        "end": 37.64
      },
      {
        "scene": "S04",
        "text": "Savitri asked for blessings on her family and for children of her own.",
        "start": 38.22,
        "end": 42.827
      },
      {
        "scene": "S05",
        "text": "Her final request made the contradiction impossible: how could she have children with Satyavan if he remained dead?",
        "start": 43.92,
        "end": 51.4
      },
      {
        "scene": "S05",
        "text": "Yama restored his life.",
        "start": 51.96,
        "end": 53.824
      },
      {
        "scene": "S06",
        "text": "She had not overpowered death with a weapon.",
        "start": 54.924,
        "end": 57.82
      },
      {
        "scene": "S06",
        "text": "She had followed it with resolve and reason, and brought her husband home.",
        "start": 58.5,
        "end": 63.0
      }
    ],
