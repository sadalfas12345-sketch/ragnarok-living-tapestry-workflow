    "phrases": [
      {
        "scene": "S01",
        "text": "Two young heroes, Hunahpu and Xbalanque, were summoned into Xibalba, the underworld.",
        "start": 0.0,
        "end": 6.6
      },
      {
        "scene": "S01",
        "text": "Its lords specialized in humiliating and defeating visitors through trickery.",
        "start": 7.3,
        "end": 12.26
      },
      {
        "scene": "S02",
        "text": "The brothers entered houses filled with darkness, sharp blades, cold and fierce creatures.",
        "start": 13.1,
        "end": 19.84
      },
      {
        "scene": "S02",
        "text": "Each test demanded more than physical courage.",
        "start": 20.42,
        "end": 23.42
      },
      {
        "scene": "S03",
        "text": "The lords challenged them at ball play and set cruel tasks.",
        "start": 24.44,
        "end": 29.26
      },
      {
        "scene": "S03",
        "text": "The twins answered with observation, cooperation and deception of their own.",
        "start": 29.26,
        "end": 34.274
      },
      {
        "scene": "S04",
        "text": "The story tells of death, transformation and astonishing returns.",
        "start": 35.6,
        "end": 40.48
      },
      {
        "scene": "S04",
        "text": "In the end the twins used the lords’ desire for spectacle against them.",
        "start": 41.1,
        "end": 45.476
      },
      {
        "scene": "S05",
        "text": "When the lords expected to be restored after imitating the trick, the brothers refused.",
        "start": 46.56,
        "end": 52.0
      },
      {
        "scene": "S05",
        "text": "Xibalba’s authority was broken.",
        "start": 52.82,
        "end": 54.871
      },
      {
        "scene": "S06",
        "text": "In the Popol Vuh, the victory helps reorder the cosmos and honors family memory.",
        "start": 55.971,
        "end": 62.5
      },
      {
        "scene": "S06",
        "text": "The strongest weapon is knowing a trickster better than he knows himself.",
        "start": 63.18,
        "end": 67.42
      }
    ],
