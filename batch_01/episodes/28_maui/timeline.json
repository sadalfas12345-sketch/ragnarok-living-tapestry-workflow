  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "Across Polynesian traditions, Māui is a restless trickster and culture hero.",
        "start": 0.0,
        "end": 6.46
      },
      {
        "scene": "S01",
        "text": "In some stories, he hid a miraculous fishhook aboard his brothers’ canoe.",
        "start": 7.04,
        "end": 12.38
      },
      {
        "scene": "S02",
        "text": "The brothers rowed out to sea.",
        "start": 13.22,
        "end": 15.16
      },
      {
        "scene": "S02",
        "text": "Māui lowered his line far below the surface, where it caught on something too vast to move easily.",
        "start": 15.82,
        "end": 21.86
      },
      {
        "scene": "S03",
        "text": "The canoe shook.",
        "start": 22.88,
        "end": 23.88
      },
      {
        "scene": "S03",
        "text": "Māui urged his brothers to pull together, but what rose was no ordinary catch.",
        "start": 23.88,
        "end": 29.96
      },
      {
        "scene": "S03",
        "text": "Earth itself came up from the water.",
        "start": 30.68,
        "end": 32.6
      },
      {
        "scene": "S04",
        "text": "In Māori traditions, this story is associated with the North Island of Aotearoa New Zealand, Te Ika-a-Māui, the fish of Māui.",
        "start": 33.72,
        "end": 44.38
      },
      {
        "scene": "S04",
        "text": "Other islands tell different versions.",
        "start": 44.68,
        "end": 46.7
      },
      {
        "scene": "S05",
        "text": "The brothers’ actions shaped the new land in some tellings.",
        "start": 47.92,
        "end": 51.38
      },
      {
        "scene": "S05",
        "text": "The terrain became hills and valleys, a landscape explained through the hero’s audacity.",
        "start": 51.38,
        "end": 58.149
      },
      {
        "scene": "S06",
        "text": "Māui’s feats belong to living cultures, not a single interchangeable Pacific myth.",
        "start": 59.72,
        "end": 65.06
      },
      {
        "scene": "S06",
        "text": "This episode follows one strand of a much wider ocean of stories.",
        "start": 65.64,
        "end": 70.16
      }
    ],
