    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "In one Akan tale, all the world’s stories belonged to Nyame, the sky god.",
        "start": 0.0,
        "end": 6.06
      },
      {
        "scene": "S01",
        "text": "The spider Anansi wanted to bring them down to the people.",
        "start": 6.76,
        "end": 9.88
      },
      {
        "scene": "S02",
        "text": "Nyame demanded extraordinarily difficult prizes.",
        "start": 10.92,
        "end": 14.0
      },
      {
        "scene": "S02",
        "text": "Among them were dangerous creatures no small spider should have been able to capture.",
        "start": 14.78,
        "end": 19.92
      },
      {
        "scene": "S03",
        "text": "Anansi tricked a great python by persuading it to lie against a long stick for measurement.",
        "start": 21.02,
        "end": 26.58
      },
      {
        "scene": "S03",
        "text": "The comparison became a trap.",
        "start": 26.58,
        "end": 29.18
      },
      {
        "scene": "S04",
        "text": "He deceived hornets with a story about rain and coaxed them into a container.",
        "start": 30.34,
        "end": 35.36
      },
      {
        "scene": "S04",
        "text": "His greatest resource was not size but inventiveness.",
        "start": 36.1,
        "end": 39.94
      },
      {
        "scene": "S05",
        "text": "By one clever stratagem after another, Anansi assembled the price.",
        "start": 41.04,
        "end": 46.08
      },
      {
        "scene": "S05",
        "text": "The sky god had to honor the bargain he himself had offered.",
        "start": 46.72,
        "end": 50.279
      },
      {
        "scene": "S06",
        "text": "Anansi won the stories, which could now circulate among people.",
        "start": 51.72,
        "end": 55.94
      },
      {
        "scene": "S06",
        "text": "His small body carried a large proposition: wit can confront authority on its own terms.",
        "start": 55.94,
        "end": 62.86
      }
    ],
