    "phrases": [
      {
        "scene": "S01",
        "text": "Once, according to a Chinese legend, ten suns rose together instead of taking turns.",
        "start": 0.0,
        "end": 6.74
      },
      {
        "scene": "S01",
        "text": "Rivers dried, crops burned, and ordinary people suffered under relentless heat.",
        "start": 7.68,
        "end": 13.457
      },
      {
        "scene": "S02",
        "text": "The earth could not survive ten heavens burning at once.",
        "start": 14.26,
        "end": 17.74
      },
      {
        "scene": "S02",
        "text": "Hunters, farmers, and animals searched in vain for water or shade.",
        "start": 18.6,
        "end": 22.92
      },
      {
        "scene": "S03",
        "text": "Hou Yi raised his bow.",
        "start": 23.577,
        "end": 25.46
      },
      {
        "scene": "S03",
        "text": "He was asked to restore balance where power from above had scorched the world below.",
        "start": 26.06,
        "end": 31.623
      },
      {
        "scene": "S04",
        "text": "He shot down nine suns, one after another.",
        "start": 32.78,
        "end": 35.48
      },
      {
        "scene": "S04",
        "text": "Each impact dimmed the sky until only the light the world needed remained.",
        "start": 36.12,
        "end": 40.88
      },
      {
        "scene": "S05",
        "text": "With a single sun moving overhead, crops could grow again.",
        "start": 42.04,
        "end": 46.3
      },
      {
        "scene": "S05",
        "text": "Water returned to land that had nearly become desert.",
        "start": 46.9,
        "end": 50.12
      },
      {
        "scene": "S06",
        "text": "The hero did not make the world safe by destroying all power.",
        "start": 51.264,
        "end": 55.96
      },
      {
        "scene": "S06",
        "text": "He made it livable by leaving enough—and no more.",
        "start": 56.5,
        "end": 59.44
      }
    ],
