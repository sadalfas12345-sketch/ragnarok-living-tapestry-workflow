    "phrases": [
      {
        "scene": "S01",
        "text": "The sun goddess Amaterasu withdrew into a heavenly cave after violent conduct by her brother Susanoo.",
        "start": 0.0,
        "end": 7.5
      },
      {
        "scene": "S01",
        "text": "With her light hidden, darkness settled across the world.",
        "start": 8.08,
        "end": 12.08
      },
      {
        "scene": "S02",
        "text": "The other gods gathered outside.",
        "start": 12.84,
        "end": 14.68
      },
      {
        "scene": "S02",
        "text": "Fields and living creatures waited without sunlight.",
        "start": 15.38,
        "end": 18.82
      },
      {
        "scene": "S02",
        "text": "They could not simply command the cave to open.",
        "start": 19.34,
        "end": 21.92
      },
      {
        "scene": "S03",
        "text": "The goddess Ame-no-Uzume began a wild dance.",
        "start": 22.94,
        "end": 26.2
      },
      {
        "scene": "S03",
        "text": "The assembled gods laughed so loudly that curiosity stirred behind the stone door.",
        "start": 26.2,
        "end": 32.681
      },
      {
        "scene": "S04",
        "text": "Amaterasu peered out to discover why everyone celebrated without her.",
        "start": 34.0,
        "end": 38.8
      },
      {
        "scene": "S04",
        "text": "A sacred mirror caught her eye, and the gods seized their chance.",
        "start": 39.18,
        "end": 43.77
      },
      {
        "scene": "S05",
        "text": "The cave opened fully, and light poured back over heaven and earth.",
        "start": 44.94,
        "end": 49.22
      },
      {
        "scene": "S05",
        "text": "A rope marked the passage that must not close again.",
        "start": 49.92,
        "end": 53.384
      },
      {
        "scene": "S06",
        "text": "In this myth, even the sun returns through ingenuity, ritual, and laughter—not force alone.",
        "start": 54.484,
        "end": 62.16
      },
      {
        "scene": "S06",
        "text": "The world needed every god to work together.",
        "start": 62.74,
        "end": 65.48
      }
    ],
