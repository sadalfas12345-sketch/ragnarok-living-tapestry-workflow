    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "The epic of Sunjata tells of a boy whose early difficulties made others doubt him.",
        "start": 0.0,
        "end": 5.54
      },
      {
        "scene": "S01",
        "text": "His mother Sogolon endured ridicule, while rivals plotted around the court.",
        "start": 6.02,
        "end": 11.44
      },
      {
        "scene": "S02",
        "text": "In a celebrated episode, Sunjata rises and shows strength that surprises everyone.",
        "start": 12.2,
        "end": 18.44
      },
      {
        "scene": "S02",
        "text": "Oral versions differ, but the moment becomes a symbol of possibility.",
        "start": 19.08,
        "end": 23.7
      },
      {
        "scene": "S03",
        "text": "Court rivalries forced Sunjata and his family away from their home.",
        "start": 24.82,
        "end": 29.04
      },
      {
        "scene": "S03",
        "text": "They survived through networks of welcome and loyalty beyond the palace walls.",
        "start": 29.04,
        "end": 34.771
      },
      {
        "scene": "S04",
        "text": "When the ruler Sumanguru threatened the region, Sunjata returned with allies gathered across communities.",
        "start": 36.0,
        "end": 43.1
      },
      {
        "scene": "S04",
        "text": "His power depended on coalition, not bloodline alone.",
        "start": 43.84,
        "end": 48.34
      },
      {
        "scene": "S05",
        "text": "The epic associates his victory with the battle of Kirina.",
        "start": 49.5,
        "end": 52.98
      },
      {
        "scene": "S05",
        "text": "Details of the contest belong to oral traditions that are not identical to a modern military record.",
        "start": 53.74,
        "end": 59.999
      },
      {
        "scene": "S06",
        "text": "Sunjata became the founding figure of the Mali Empire in collective memory.",
        "start": 61.5,
        "end": 66.22
      },
      {
        "scene": "S06",
        "text": "His story is preserved through living griot performance, where history and meaning travel together.",
        "start": 67.08,
        "end": 73.64
      }
    ],
