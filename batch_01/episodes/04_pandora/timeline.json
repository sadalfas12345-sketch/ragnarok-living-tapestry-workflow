  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "In an ancient Greek account, the gods fashioned Pandora and sent her among humans.",
        "start": 0.0,
        "end": 6.46
      },
      {
        "scene": "S01",
        "text": "She carried a sealed jar, though its contents were not hers to command.",
        "start": 7.18,
        "end": 11.72
      },
      {
        "scene": "S02",
        "text": "Epimetheus accepted the gift despite his brother Prometheus having warned him about presents from Zeus.",
        "start": 12.66,
        "end": 19.6
      },
      {
        "scene": "S02",
        "text": "The jar waited in their home, heavy with mystery.",
        "start": 20.26,
        "end": 23.38
      },
      {
        "scene": "S03",
        "text": "When Pandora removed its lid, afflictions escaped and spread into the human world.",
        "start": 24.136,
        "end": 31.26
      },
      {
        "scene": "S03",
        "text": "Illness, toil, and suffering could no longer be contained.",
        "start": 31.76,
        "end": 36.02
      },
      {
        "scene": "S04",
        "text": "She tried to close it.",
        "start": 37.28,
        "end": 38.86
      },
      {
        "scene": "S04",
        "text": "But the things already released moved beyond any human hand, turning a single moment into a permanent condition of life.",
        "start": 39.06,
        "end": 48.112
      },
      {
        "scene": "S05",
        "text": "Only Elpis remained inside the jar.",
        "start": 49.18,
        "end": 51.62
      },
      {
        "scene": "S05",
        "text": "That word is often rendered as hope, though scholars debate whether its confinement is comforting or troubling.",
        "start": 51.62,
        "end": 59.32
      },
      {
        "scene": "S06",
        "text": "Was hope preserved for humanity, or withheld?",
        "start": 60.82,
        "end": 63.58
      },
      {
        "scene": "S06",
        "text": "The oldest telling does not settle the answer neatly.",
        "start": 64.3,
        "end": 67.2
      },
      {
        "scene": "S06",
        "text": "That uncertainty is what keeps Pandora’s jar open in our imagination.",
        "start": 67.94,
        "end": 72.7
      }
    ],
