    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "Inanna, goddess of love and power, descended to the realm ruled by her sister Ereshkigal.",
        "start": 0.0,
        "end": 6.46
      },
      {
        "scene": "S01",
        "text": "Seven gates barred the way, and every gate demanded a price.",
        "start": 7.86,
        "end": 11.68
      },
      {
        "scene": "S02",
        "text": "At each gate a piece of her regalia was taken.",
        "start": 12.44,
        "end": 15.5
      },
      {
        "scene": "S02",
        "text": "Crown, jewels and marks of authority vanished until she faced her sister without the signs of power.",
        "start": 16.12,
        "end": 22.946
      },
      {
        "scene": "S03",
        "text": "The judges of the underworld condemned Inanna.",
        "start": 23.88,
        "end": 26.62
      },
      {
        "scene": "S03",
        "text": "Her lifeless body was suspended, while her servant Ninshubur sought help in the world above.",
        "start": 26.62,
        "end": 33.515
      },
      {
        "scene": "S04",
        "text": "Help came through beings sent to the underworld, and Inanna rose again.",
        "start": 34.68,
        "end": 39.02
      },
      {
        "scene": "S04",
        "text": "But there was a law: a replacement would have to descend in her place.",
        "start": 39.52,
        "end": 43.737
      },
      {
        "scene": "S05",
        "text": "Accounts tell of Dumuzi becoming entangled in that demand.",
        "start": 44.94,
        "end": 48.5
      },
      {
        "scene": "S05",
        "text": "His fate joined the rhythms of absence and return, grief and seasonal renewal.",
        "start": 49.1,
        "end": 54.86
      },
      {
        "scene": "S06",
        "text": "Even a great goddess could not cross death’s borders without consequence.",
        "start": 56.096,
        "end": 60.74
      },
      {
        "scene": "S06",
        "text": "The story is less a victory over mortality than a warning about its price.",
        "start": 61.54,
        "end": 66.12
      }
    ],
