  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "In 1582, Oda Nobunaga was close to dominating Japan.",
        "start": 0.0,
        "end": 5.64
      },
      {
        "scene": "S01",
        "text": "He stayed at Kyoto’s Honnō-ji temple with a small escort, trusting that his own commanders held the roads.",
        "start": 6.28,
        "end": 13.36
      },
      {
        "scene": "S02",
        "text": "Akechi Mitsuhide, one of Nobunaga’s generals, marched his army toward Kyoto.",
        "start": 14.32,
        "end": 20.38
      },
      {
        "scene": "S02",
        "text": "Instead of attacking an outside enemy, his soldiers surrounded their own lord.",
        "start": 21.1,
        "end": 26.46
      },
      {
        "scene": "S03",
        "text": "The temple became a battlefield.",
        "start": 27.11,
        "end": 29.36
      },
      {
        "scene": "S03",
        "text": "Outnumbered, Nobunaga died as fire consumed the buildings; the precise circumstances of his final moments remain uncertain.",
        "start": 30.08,
        "end": 39.98
      },
      {
        "scene": "S04",
        "text": "Why did Mitsuhide turn?",
        "start": 41.22,
        "end": 42.5
      },
      {
        "scene": "S04",
        "text": "Grievance, ambition, fear and political calculation have all been proposed.",
        "start": 43.1,
        "end": 48.44
      },
      {
        "scene": "S04",
        "text": "No single motive has been established beyond serious dispute.",
        "start": 49.16,
        "end": 53.56
      },
      {
        "scene": "S05",
        "text": "Mitsuhide’s triumph did not last.",
        "start": 54.68,
        "end": 57.12
      },
      {
        "scene": "S05",
        "text": "Toyotomi Hideyoshi hurried back, defeated him at Yamazaki, and the rebellion collapsed within days.",
        "start": 57.78,
        "end": 65.4
      },
      {
        "scene": "S06",
        "text": "The betrayal killed Nobunaga—but cleared the way for another unifier.",
        "start": 66.82,
        "end": 71.12
      },
      {
        "scene": "S06",
        "text": "A decision intended to seize power can end by handing it to someone else.",
        "start": 71.12,
        "end": 76.84
      }
    ],
