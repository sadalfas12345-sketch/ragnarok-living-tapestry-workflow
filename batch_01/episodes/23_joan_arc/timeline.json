    "phrases": [
      {
        "scene": "S01",
        "text": "A teenage peasant from Lorraine said she heard saints urging her to help France.",
        "start": 0.0,
        "end": 5.26
      },
      {
        "scene": "S01",
        "text": "In 1429, Joan reached the French royal court during a desperate war.",
        "start": 5.88,
        "end": 11.176
      },
      {
        "scene": "S02",
        "text": "She helped inspire a French effort at Orléans, where the siege was lifted.",
        "start": 12.0,
        "end": 16.88
      },
      {
        "scene": "S02",
        "text": "Her presence turned military momentum into a powerful political symbol.",
        "start": 17.48,
        "end": 22.76
      },
      {
        "scene": "S03",
        "text": "The campaign helped clear a path for Charles the Seventh to be crowned at Reims.",
        "start": 23.72,
        "end": 29.54
      },
      {
        "scene": "S03",
        "text": "Joan had helped accomplish what had seemed unreachable.",
        "start": 29.54,
        "end": 32.58
      },
      {
        "scene": "S04",
        "text": "Soon after, Joan was captured by Burgundian forces and transferred to English custody.",
        "start": 33.78,
        "end": 39.9
      },
      {
        "scene": "S04",
        "text": "Her enemies pursued her through an ecclesiastical trial.",
        "start": 40.68,
        "end": 44.389
      },
      {
        "scene": "S05",
        "text": "The court condemned Joan, including allegations tied to her claimed revelations and clothing.",
        "start": 45.48,
        "end": 52.04
      },
      {
        "scene": "S05",
        "text": "She was executed by burning in Rouen in 1431, about nineteen years old.",
        "start": 52.04,
        "end": 58.449
      },
      {
        "scene": "S06",
        "text": "A later inquiry overturned the condemnation.",
        "start": 60.04,
        "end": 62.82
      },
      {
        "scene": "S06",
        "text": "The case shows how military, religious and political power could shape whose voice was called holy—and whose was called dangerous.",
        "start": 63.64,
        "end": 72.26
      }
    ],
