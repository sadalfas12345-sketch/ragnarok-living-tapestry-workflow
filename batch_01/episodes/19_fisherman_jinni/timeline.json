    "phrases": [
      {
        "scene": "S01",
        "text": "A poor fisherman hauled a heavy sealed vessel from the sea.",
        "start": 0.0,
        "end": 4.38
      },
      {
        "scene": "S01",
        "text": "Inside was no treasure, only an enormous spirit imprisoned for centuries.",
        "start": 4.96,
        "end": 10.04
      },
      {
        "scene": "S02",
        "text": "The jinni emerged in smoke and announced that his first decision was to kill the person who had freed him.",
        "start": 10.9,
        "end": 17.98
      },
      {
        "scene": "S02",
        "text": "Gratitude had curdled into rage.",
        "start": 18.46,
        "end": 20.46
      },
      {
        "scene": "S03",
        "text": "The fisherman did not reach for a sword.",
        "start": 21.42,
        "end": 23.7
      },
      {
        "scene": "S03",
        "text": "He asked a question: how could such a gigantic spirit ever have fitted into so small a vessel?",
        "start": 24.26,
        "end": 30.68
      },
      {
        "scene": "S04",
        "text": "Offended, the jinni turned to smoke and flowed back inside to prove the feat.",
        "start": 32.04,
        "end": 37.58
      },
      {
        "scene": "S04",
        "text": "The fisherman immediately sealed the lid.",
        "start": 37.58,
        "end": 40.222
      },
      {
        "scene": "S05",
        "text": "Now the prisoner begged for release.",
        "start": 41.4,
        "end": 43.52
      },
      {
        "scene": "S05",
        "text": "The fisherman had reversed their positions with nothing but a question and quick hands.",
        "start": 44.16,
        "end": 49.66
      },
      {
        "scene": "S06",
        "text": "In stories like this, intelligence is the weapon of those without force.",
        "start": 50.79,
        "end": 56.14
      },
      {
        "scene": "S06",
        "text": "The man who owned almost nothing suddenly controlled the bargain.",
        "start": 56.84,
        "end": 60.54
      }
    ],
