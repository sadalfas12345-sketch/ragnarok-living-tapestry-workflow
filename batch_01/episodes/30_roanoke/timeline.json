  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "What if an entire town just disappeared?",
        "start": 0.0,
        "end": 2.46
      },
      {
        "scene": "S01",
        "text": "In 1590, governor John White returned to Roanoke Island after years away.",
        "start": 3.1,
        "end": 9.32
      },
      {
        "scene": "S01",
        "text": "He came looking for his family and the colonists he had left behind.",
        "start": 9.9,
        "end": 14.32
      },
      {
        "scene": "S01",
        "text": "Instead, he found empty houses, silent paths, and no one waiting for him.",
        "start": 15.1,
        "end": 20.864
      },
      {
        "scene": "S02",
        "text": "Then he found one word carved into the settlement: Croatoan.",
        "start": 21.62,
        "end": 25.52
      },
      {
        "scene": "S02",
        "text": "It was the first sign that the settlers may have left alive.",
        "start": 25.52,
        "end": 29.68
      },
      {
        "scene": "S02",
        "text": "But it was only a clue—and the people who could explain it were gone.",
        "start": 30.16,
        "end": 34.497
      },
      {
        "scene": "S03",
        "text": "White had been trapped across the Atlantic by war and failing supplies.",
        "start": 35.52,
        "end": 40.0
      },
      {
        "scene": "S03",
        "text": "Year after year, the colony had waited without rescue.",
        "start": 40.62,
        "end": 44.56
      },
      {
        "scene": "S03",
        "text": "By the time he returned, years had passed and the settlers had been left to survive without help.",
        "start": 45.22,
        "end": 52.074
      },
      {
        "scene": "S04",
        "text": "Maybe the settlers moved inland.",
        "start": 52.874,
        "end": 55.16
      },
      {
        "scene": "S04",
        "text": "Maybe they joined Indigenous communities.",
        "start": 55.92,
        "end": 57.98
      },
      {
        "scene": "S04",
        "text": "Maybe hunger, disease, or violence ended their journey.",
        "start": 58.84,
        "end": 62.96
      },
      {
        "scene": "S04",
        "text": "No one left a record explaining what happened to them all.",
        "start": 63.68,
        "end": 66.973
      },
      {
        "scene": "S05",
        "text": "The English remembered it as the Lost Colony.",
        "start": 68.08,
        "end": 70.82
      },
      {
        "scene": "S05",
        "text": "But this was not an empty wilderness waiting for a European mystery.",
        "start": 71.38,
        "end": 76.12
      },
      {
        "scene": "S05",
        "text": "Indigenous communities already lived here, and they may have seen the settlers' fear, flight, or disappearance from a side the surviving records never preserved.",
        "start": 76.12,
        "end": 88.18
      },
      {
        "scene": "S06",
        "text": "Roanoke still offers no final answer.",
        "start": 89.7,
        "end": 92.18
      },
      {
        "scene": "S06",
        "text": "The surviving records cannot tell us who lived, who died, or where the settlers went.",
        "start": 92.84,
        "end": 98.94
      },
      {
        "scene": "S06",
        "text": "What remains is the terror of isolation, and the knowledge that an entire community can vanish without leaving a clear explanation.",
        "start": 98.94,
        "end": 108.42
      }
    ],
