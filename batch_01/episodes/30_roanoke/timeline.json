  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "In 1590, governor John White returned to an English settlement on Roanoke Island.",
        "start": 0.0,
        "end": 6.84
      },
      {
        "scene": "S01",
        "text": "He expected to find colonists, including his family.",
        "start": 7.5,
        "end": 10.96
      },
      {
        "scene": "S01",
        "text": "Instead, the site was deserted.",
        "start": 11.7,
        "end": 13.84
      },
      {
        "scene": "S02",
        "text": "A word associated with Croatoan was carved at the site.",
        "start": 14.8,
        "end": 18.42
      },
      {
        "scene": "S02",
        "text": "It offered a possible clue, but not a complete explanation of where everyone had gone.",
        "start": 18.84,
        "end": 25.145
      },
      {
        "scene": "S03",
        "text": "White had been delayed for years by war and supply difficulties across the Atlantic.",
        "start": 25.795,
        "end": 31.74
      },
      {
        "scene": "S03",
        "text": "The colony had spent that time without the help it expected.",
        "start": 32.46,
        "end": 35.9
      },
      {
        "scene": "S04",
        "text": "The settlers may have moved, joined Indigenous communities, or faced several hardships.",
        "start": 37.02,
        "end": 43.18
      },
      {
        "scene": "S04",
        "text": "Historians cannot reconstruct the full fate of every person from the evidence.",
        "start": 44.34,
        "end": 49.24
      },
      {
        "scene": "S05",
        "text": "The popular phrase lost colony centers the English record.",
        "start": 50.44,
        "end": 54.12
      },
      {
        "scene": "S05",
        "text": "Indigenous peoples already lived in the region, and their history is not an empty backdrop to a European mystery.",
        "start": 54.12,
        "end": 62.708
      },
      {
        "scene": "S06",
        "text": "Roanoke remains unresolved, but absence of a surviving English account is not proof of supernatural disappearance.",
        "start": 64.34,
        "end": 72.18
      },
      {
        "scene": "S06",
        "text": "The true story is about isolation, contact, and uncertain evidence.",
        "start": 72.98,
        "end": 78.32
      }
    ],
