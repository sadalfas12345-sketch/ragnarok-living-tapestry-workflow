    "phrases": [
      {
        "scene": "S01",
        "text": "King Midas did a kindness for a companion of Dionysus.",
        "start": 0.0,
        "end": 4.68
      },
      {
        "scene": "S01",
        "text": "In return, the god offered him a reward.",
        "start": 5.2,
        "end": 8.14
      },
      {
        "scene": "S01",
        "text": "Midas chose the power to turn anything he touched into gold.",
        "start": 8.94,
        "end": 12.74
      },
      {
        "scene": "S02",
        "text": "At first it seemed perfect.",
        "start": 13.54,
        "end": 15.42
      },
      {
        "scene": "S02",
        "text": "A branch became treasure.",
        "start": 16.04,
        "end": 17.6
      },
      {
        "scene": "S02",
        "text": "A stone became treasure.",
        "start": 18.42,
        "end": 19.9
      },
      {
        "scene": "S02",
        "text": "The ordinary world glittered beneath his fingertips.",
        "start": 20.46,
        "end": 23.62
      },
      {
        "scene": "S03",
        "text": "Then Midas sat down to eat.",
        "start": 24.78,
        "end": 26.8
      },
      {
        "scene": "S03",
        "text": "Bread hardened into metal.",
        "start": 27.38,
        "end": 28.66
      },
      {
        "scene": "S03",
        "text": "Wine shone like gold, but could no longer nourish him.",
        "start": 28.66,
        "end": 33.235
      },
      {
        "scene": "S04",
        "text": "The king had acquired limitless riches, and lost the ability to enjoy the simplest meal.",
        "start": 34.32,
        "end": 40.44
      },
      {
        "scene": "S04",
        "text": "The blessing measured everything by value, except the value of living.",
        "start": 41.06,
        "end": 45.94
      },
      {
        "scene": "S05",
        "text": "Horrified, Midas begged Dionysus to take the gift away.",
        "start": 47.28,
        "end": 51.36
      },
      {
        "scene": "S05",
        "text": "The god directed him to wash in the river Pactolus.",
        "start": 51.92,
        "end": 55.48
      },
      {
        "scene": "S06",
        "text": "Midas entered the water and shed the fatal touch.",
        "start": 56.96,
        "end": 60.32
      },
      {
        "scene": "S06",
        "text": "He had learned too late that more wealth does not mean more life.",
        "start": 61.04,
        "end": 64.52
      }
    ],
