    "phrases": [
      {
        "scene": "S01",
        "text": "Two woodcutters sheltered from a deadly snowstorm.",
        "start": 0.0,
        "end": 3.68
      },
      {
        "scene": "S01",
        "text": "During the night, a pale woman entered, and one man died beneath her freezing breath.",
        "start": 4.46,
        "end": 11.469
      },
      {
        "scene": "S02",
        "text": "She spared the younger man, Minokichi, only if he never told anyone what he had seen.",
        "start": 12.3,
        "end": 18.66
      },
      {
        "scene": "S02",
        "text": "By morning she had vanished into the blizzard.",
        "start": 19.22,
        "end": 21.76
      },
      {
        "scene": "S03",
        "text": "Minokichi later married a beautiful woman called O-Yuki.",
        "start": 22.88,
        "end": 26.8
      },
      {
        "scene": "S03",
        "text": "They built a life together and raised children; the winter vision slowly became a secret memory.",
        "start": 26.8,
        "end": 34.585
      },
      {
        "scene": "S04",
        "text": "One evening he told his wife the old tale.",
        "start": 35.74,
        "end": 38.54
      },
      {
        "scene": "S04",
        "text": "As he spoke, she changed: O-Yuki was the very woman who had made him promise silence.",
        "start": 39.06,
        "end": 46.16
      },
      {
        "scene": "S05",
        "text": "She was furious that he had broken his word, but for their children she spared his life.",
        "start": 47.38,
        "end": 53.58
      },
      {
        "scene": "S05",
        "text": "Then she disappeared into the night.",
        "start": 53.58,
        "end": 55.919
      },
      {
        "scene": "S06",
        "text": "He kept the family, but lost the woman he loved.",
        "start": 57.36,
        "end": 60.74
      },
      {
        "scene": "S06",
        "text": "Some promises are not tested until a lifetime has passed.",
        "start": 61.58,
        "end": 64.898
      }
    ],
