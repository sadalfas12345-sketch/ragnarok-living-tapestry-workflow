    "phrases": [
      {
        "scene": "S01",
        "text": "A young champion named Sohrab grew up seeking his father, the mighty warrior Rostam.",
        "start": 0.0,
        "end": 6.42
      },
      {
        "scene": "S01",
        "text": "War placed them on opposing sides before they could truly meet.",
        "start": 7.14,
        "end": 10.949
      },
      {
        "scene": "S02",
        "text": "Schemes and uncertainty kept the truth concealed.",
        "start": 11.88,
        "end": 15.08
      },
      {
        "scene": "S02",
        "text": "Two unmatched warriors entered combat, each unaware that his opponent was his own blood.",
        "start": 15.82,
        "end": 22.073
      },
      {
        "scene": "S03",
        "text": "Their struggle shook the battlefield.",
        "start": 22.98,
        "end": 24.9
      },
      {
        "scene": "S03",
        "text": "Rostam finally struck a fatal blow, believing he had defeated a dangerous enemy.",
        "start": 25.68,
        "end": 32.018
      },
      {
        "scene": "S04",
        "text": "Only afterward did a token reveal Sohrab’s identity.",
        "start": 33.14,
        "end": 36.38
      },
      {
        "scene": "S04",
        "text": "The victor realized he had killed the son he had never known.",
        "start": 37.06,
        "end": 40.92
      },
      {
        "scene": "S05",
        "text": "Rostam cried out for help, but the damage could not be reversed.",
        "start": 42.1,
        "end": 46.52
      },
      {
        "scene": "S05",
        "text": "His greatest strength had brought him the worst possible defeat.",
        "start": 47.14,
        "end": 51.04
      },
      {
        "scene": "S06",
        "text": "The Shahnameh preserves a tragedy in which courage cannot compensate for deception and silence.",
        "start": 52.16,
        "end": 59.08
      },
      {
        "scene": "S06",
        "text": "A battlefield victory becomes a lifetime of grief.",
        "start": 59.9,
        "end": 63.26
      }
    ],
