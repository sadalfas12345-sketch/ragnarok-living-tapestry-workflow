    "phrases": [
      {
        "scene": "S01",
        "text": "In 1483, young Edward the Fifth and his brother Richard were housed in the Tower of London during a struggle over the English crown.",
        "start": 0.0,
        "end": 9.98
      },
      {
        "scene": "S02",
        "text": "Their uncle became King Richard the Third after the boys’ claim was declared invalid.",
        "start": 10.82,
        "end": 16.08
      },
      {
        "scene": "S02",
        "text": "The princes gradually disappeared from public view.",
        "start": 16.68,
        "end": 19.849
      },
      {
        "scene": "S03",
        "text": "No secure record shows exactly when or how the brothers died.",
        "start": 20.9,
        "end": 24.96
      },
      {
        "scene": "S03",
        "text": "Their absence became the most enduring mystery of the dynasty.",
        "start": 24.96,
        "end": 29.48
      },
      {
        "scene": "S04",
        "text": "Richard the Third has long been suspected, but other possible perpetrators and scenarios have been proposed.",
        "start": 30.78,
        "end": 38.58
      },
      {
        "scene": "S04",
        "text": "The surviving evidence does not conclusively identify a killer.",
        "start": 38.58,
        "end": 42.4
      },
      {
        "scene": "S05",
        "text": "Centuries later, remains found in the Tower were traditionally identified as the princes, but their identity has not been conclusively established by modern testing.",
        "start": 43.68,
        "end": 55.38
      },
      {
        "scene": "S06",
        "text": "The brothers became symbols of a brutal question: when a kingdom changes hands, who can protect children whose existence threatens the new ruler?",
        "start": 56.82,
        "end": 66.98
      }
    ],
