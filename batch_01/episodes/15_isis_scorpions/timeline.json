    "phrases": [
      {
        "scene": "S01",
        "text": "Isis fled danger with the child Horus.",
        "start": 0.0,
        "end": 3.38
      },
      {
        "scene": "S01",
        "text": "Seven scorpions guarded her as she traveled, vulnerable despite her divine identity.",
        "start": 4.32,
        "end": 10.32
      },
      {
        "scene": "S02",
        "text": "A wealthy woman closed her door to them.",
        "start": 11.26,
        "end": 13.82
      },
      {
        "scene": "S02",
        "text": "A poorer woman welcomed the travelers, offering what little shelter she could.",
        "start": 14.36,
        "end": 19.24
      },
      {
        "scene": "S03",
        "text": "The scorpions took revenge.",
        "start": 20.2,
        "end": 22.08
      },
      {
        "scene": "S03",
        "text": "One carried their gathered venom and stung the wealthy woman’s child, turning a refusal of hospitality into tragedy.",
        "start": 22.76,
        "end": 31.097
      },
      {
        "scene": "S04",
        "text": "The mother pleaded for help.",
        "start": 32.3,
        "end": 33.96
      },
      {
        "scene": "S04",
        "text": "Isis heard the grief and refused to let an innocent child pay for the adult’s action.",
        "start": 34.42,
        "end": 39.75
      },
      {
        "scene": "S05",
        "text": "Through powerful spoken names and magic, Isis drew out the poison.",
        "start": 40.86,
        "end": 45.86
      },
      {
        "scene": "S05",
        "text": "The child recovered, and the household learned what had been denied at its door.",
        "start": 46.58,
        "end": 51.517
      },
      {
        "scene": "S06",
        "text": "The story does not end with revenge.",
        "start": 52.9,
        "end": 55.32
      },
      {
        "scene": "S06",
        "text": "Its strongest image is a goddess saving someone who had turned her away.",
        "start": 55.32,
        "end": 60.26
      }
    ],
