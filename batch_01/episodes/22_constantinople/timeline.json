    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "For centuries Constantinople stood behind formidable walls.",
        "start": 0.0,
        "end": 4.54
      },
      {
        "scene": "S01",
        "text": "In 1453, Sultan Mehmed II brought an Ottoman army to besiege the capital of the diminished Byzantine Empire.",
        "start": 5.26,
        "end": 14.107
      },
      {
        "scene": "S02",
        "text": "Large cannons battered defenses once thought impregnable.",
        "start": 14.98,
        "end": 18.44
      },
      {
        "scene": "S02",
        "text": "The defenders repaired breaches repeatedly, short of men and hope of substantial relief.",
        "start": 19.08,
        "end": 25.54
      },
      {
        "scene": "S03",
        "text": "A chain helped defend the Golden Horn.",
        "start": 26.54,
        "end": 29.06
      },
      {
        "scene": "S03",
        "text": "Ottoman forces moved ships overland into the inlet, adding pressure from a direction the city feared.",
        "start": 29.06,
        "end": 36.658
      },
      {
        "scene": "S04",
        "text": "After weeks of siege, the Ottomans launched a major attack on May twenty-ninth.",
        "start": 37.82,
        "end": 42.94
      },
      {
        "scene": "S04",
        "text": "The defenses broke, and the Byzantine capital fell.",
        "start": 43.88,
        "end": 47.329
      },
      {
        "scene": "S05",
        "text": "Constantine the Eleventh died during the fighting, though accounts vary about the exact circumstances.",
        "start": 48.56,
        "end": 57.44
      },
      {
        "scene": "S05",
        "text": "His empire ended with the city.",
        "start": 57.18,
        "end": 57.44
      },
      {
        "scene": "S06",
        "text": "Mehmed entered Constantinople, which became the Ottoman imperial capital.",
        "start": 58.594,
        "end": 64.04
      },
      {
        "scene": "S06",
        "text": "What ended for one state became a beginning for another—and a turning point in Mediterranean history.",
        "start": 64.68,
        "end": 71.3
      }
    ],
