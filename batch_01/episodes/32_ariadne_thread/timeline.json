  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Edge TTS native word boundaries verified against Whisper tiny.en waveform alignment",
    "phrases": [
      {
        "scene": "S01",
        "text": "What if saving someone you love is the very act that leaves you alone?",
        "start": 0.0,
        "end": 4.66
      },
      {
        "scene": "S01",
        "text": "In Greek myth, Ariadne, daughter of King Minos of Crete, sees the Athenian prince Theseus among youths condemned to enter the Labyrinth.",
        "start": 5.32,
        "end": 16.16
      },
      {
        "scene": "S01",
        "text": "He intends to face the Minotaur, a bull-headed monster.",
        "start": 18.54,
        "end": 21.92
      },
      {
        "scene": "S01",
        "text": "No one expects him to return.",
        "start": 21.92,
        "end": 22.46
      },
      {
        "scene": "S02",
        "text": "Ariadne gives Theseus a sword and a spool of red thread.",
        "start": 23.46,
        "end": 27.54
      },
      {
        "scene": "S02",
        "text": "At the maze entrance, she ties one end to the stone and makes him promise to unwind it behind him.",
        "start": 27.54,
        "end": 35.82
      },
      {
        "scene": "S02",
        "text": "The blade may kill the monster; only the thread can bring him back.",
        "start": 36.12,
        "end": 40.674
      },
      {
        "scene": "S03",
        "text": "Theseus follows the thread into darkness and finds the Minotaur.",
        "start": 41.66,
        "end": 46.2
      },
      {
        "scene": "S03",
        "text": "Their fight shakes the maze.",
        "start": 46.88,
        "end": 48.46
      },
      {
        "scene": "S03",
        "text": "When the creature falls, Theseus grips the red line and follows it toward daylight, while those outside wait for a sound.",
        "start": 49.1,
        "end": 57.449
      },
      {
        "scene": "S04",
        "text": "Ariadne chooses Theseus over her father and leaves Crete with him.",
        "start": 58.58,
        "end": 63.44
      },
      {
        "scene": "S04",
        "text": "She gives up her home, her family, and her place as a princess to save the man condemned to die.",
        "start": 63.8,
        "end": 70.5
      },
      {
        "scene": "S04",
        "text": "As the island recedes behind them, she believes she has traded her old life for a future with him.",
        "start": 71.06,
        "end": 78.26
      },
      {
        "scene": "S05",
        "text": "At Naxos, while Ariadne sleeps, Theseus has the crew leave her on the shore.",
        "start": 79.32,
        "end": 85.78
      },
      {
        "scene": "S05",
        "text": "She wakes to waves, searches empty sand, and sees his sail shrinking beyond reach.",
        "start": 86.44,
        "end": 92.92
      },
      {
        "scene": "S05",
        "text": "In that instant, rescue becomes betrayal.",
        "start": 93.48,
        "end": 96.91
      },
      {
        "scene": "S06",
        "text": "Ancient tellings disagree about Ariadne's fate.",
        "start": 98.18,
        "end": 101.78
      },
      {
        "scene": "S06",
        "text": "But the image endures: the woman who led a hero out of death is left without a home.",
        "start": 102.26,
        "end": 108.24
      },
      {
        "scene": "S06",
        "text": "On the shore, Ariadne holds one end of the red thread.",
        "start": 108.24,
        "end": 113.14
      },
      {
        "scene": "S06",
        "text": "Nothing answers from the other side.",
        "start": 113.84,
        "end": 115.768
      }
    ],
