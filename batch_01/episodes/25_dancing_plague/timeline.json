  "narration": {
    "voice": "en-US-AvaNeural",
    "alignment": "Whisper tiny.en word timestamps measured against final narration waveform",
    "phrases": [
      {
        "scene": "S01",
        "text": "In the summer of 1518, people in Strasbourg began dancing uncontrollably.",
        "start": 0.0,
        "end": 6.94
      },
      {
        "scene": "S01",
        "text": "Contemporary and later accounts describe a troubling outbreak that baffled the city.",
        "start": 7.46,
        "end": 12.938
      },
      {
        "scene": "S02",
        "text": "Reports describe more people joining, some apparently unable to stop.",
        "start": 13.7,
        "end": 18.7
      },
      {
        "scene": "S02",
        "text": "The numbers and exact details vary in the sources, but the episode became notorious.",
        "start": 19.22,
        "end": 25.04
      },
      {
        "scene": "S03",
        "text": "Authorities tried measures that included organizing space and musicians for the dancers.",
        "start": 25.891,
        "end": 31.62
      },
      {
        "scene": "S03",
        "text": "Those choices reflected theories about the illness that we would not share today.",
        "start": 32.34,
        "end": 37.082
      },
      {
        "scene": "S04",
        "text": "Chroniclers reported exhaustion and suffering.",
        "start": 38.44,
        "end": 41.22
      },
      {
        "scene": "S04",
        "text": "Claims about large numbers of deaths are much less securely documented than popular retellings suggest.",
        "start": 41.9,
        "end": 48.6
      },
      {
        "scene": "S05",
        "text": "Modern historians have considered stress, belief, disease and social contagion.",
        "start": 49.406,
        "end": 56.18
      },
      {
        "scene": "S05",
        "text": "No single cause has been proved from the surviving evidence.",
        "start": 56.72,
        "end": 59.96
      },
      {
        "scene": "S06",
        "text": "What remains is a city confronting behavior it could not control, while leaders acted without understanding its mechanism.",
        "start": 61.44,
        "end": 69.38
      },
      {
        "scene": "S06",
        "text": "The strangest part may be the response.",
        "start": 70.1,
        "end": 72.42
      }
    ],
