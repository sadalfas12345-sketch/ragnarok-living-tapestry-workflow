    "phrases": [
      {
        "scene": "S01",
        "text": "In an Egyptian myth, humanity plotted against the aging sun god Ra.",
        "start": 0.0,
        "end": 5.76
      },
      {
        "scene": "S01",
        "text": "He sent his fierce eye, Sekhmet, to punish those who defied him.",
        "start": 6.28,
        "end": 11.227
      },
      {
        "scene": "S02",
        "text": "Sekhmet struck with such fury that the destruction threatened to continue beyond any measured punishment.",
        "start": 11.677,
        "end": 18.4
      },
      {
        "scene": "S02",
        "text": "The force sent to restore order became difficult to stop.",
        "start": 19.1,
        "end": 22.649
      },
      {
        "scene": "S03",
        "text": "Ra feared she might destroy humanity entirely.",
        "start": 23.72,
        "end": 26.94
      },
      {
        "scene": "S03",
        "text": "He needed a way to halt the goddess without confronting her in another battle.",
        "start": 26.94,
        "end": 32.18
      },
      {
        "scene": "S04",
        "text": "Vast quantities of beer were colored red and poured across the fields.",
        "start": 33.52,
        "end": 38.02
      },
      {
        "scene": "S04",
        "text": "Sekhmet mistook the liquid for blood and drank deeply.",
        "start": 38.86,
        "end": 41.92
      },
      {
        "scene": "S05",
        "text": "Intoxicated, she ceased her slaughter.",
        "start": 43.16,
        "end": 45.8
      },
      {
        "scene": "S05",
        "text": "The people survived because the gods answered overwhelming violence with deception rather than more violence.",
        "start": 46.5,
        "end": 53.5
      },
      {
        "scene": "S06",
        "text": "In this tale, even divine punishment can outrun its purpose.",
        "start": 54.646,
        "end": 59.5
      },
      {
        "scene": "S06",
        "text": "Saving the world required restraining the power that claimed to defend it.",
        "start": 60.28,
        "end": 64.431
      }
    ],
