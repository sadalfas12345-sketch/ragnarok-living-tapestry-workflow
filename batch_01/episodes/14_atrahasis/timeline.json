    "phrases": [
      {
        "scene": "S01",
        "text": "In the Atrahasis epic, humanity multiplied, and its noise disturbed the gods.",
        "start": 0.0,
        "end": 7.48
      },
      {
        "scene": "S01",
        "text": "Their response grew harsher as the human world refused to fall silent.",
        "start": 7.48,
        "end": 12.18
      },
      {
        "scene": "S02",
        "text": "Attempts to reduce the population through hardship did not end the dispute.",
        "start": 13.12,
        "end": 17.52
      },
      {
        "scene": "S02",
        "text": "Finally, the gods resolved upon a devastating flood.",
        "start": 18.36,
        "end": 21.773
      },
      {
        "scene": "S03",
        "text": "Enki, sympathetic to Atrahasis, conveyed a warning indirectly.",
        "start": 22.74,
        "end": 27.76
      },
      {
        "scene": "S03",
        "text": "The human hero was told to build a vessel before the waters rose.",
        "start": 27.76,
        "end": 32.933
      },
      {
        "scene": "S04",
        "text": "Atrahasis prepared the craft and sheltered life aboard.",
        "start": 34.36,
        "end": 38.08
      },
      {
        "scene": "S04",
        "text": "Then the storm broke.",
        "start": 38.58,
        "end": 39.82
      },
      {
        "scene": "S04",
        "text": "Human settlements vanished beneath the rising water.",
        "start": 40.58,
        "end": 43.96
      },
      {
        "scene": "S05",
        "text": "The gods themselves recoiled from the scale of destruction.",
        "start": 45.08,
        "end": 48.7
      },
      {
        "scene": "S05",
        "text": "The flood exposed how deeply divine power depended on the life it nearly erased.",
        "start": 49.42,
        "end": 54.76
      },
      {
        "scene": "S06",
        "text": "Human life returned, but under new conditions in the story.",
        "start": 55.935,
        "end": 60.2
      },
      {
        "scene": "S06",
        "text": "The epic asks whether the rulers of the world understood the cost of their own decisions.",
        "start": 60.82,
        "end": 66.42
      }
    ],
