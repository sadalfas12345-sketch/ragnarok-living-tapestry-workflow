    "phrases": [
      {
        "scene": "S01",
        "text": "Before humans mastered fire, one Titan dared to defy Zeus.",
        "start": 0.0,
        "end": 5.22
      },
      {
        "scene": "S01",
        "text": "Prometheus saw people shivering in darkness and decided they deserved more than the gods allowed.",
        "start": 5.92,
        "end": 12.0
      },
      {
        "scene": "S02",
        "text": "He stole a spark from the divine realm, hiding it in a hollow fennel stalk.",
        "start": 12.8,
        "end": 18.02
      },
      {
        "scene": "S02",
        "text": "As the flame passed from hand to hand, night changed forever.",
        "start": 18.6,
        "end": 22.92
      },
      {
        "scene": "S03",
        "text": "Fire cooked food, warmed shelters, and made metalwork possible.",
        "start": 23.688,
        "end": 28.52
      },
      {
        "scene": "S03",
        "text": "In the myth, a single stolen gift shifted the balance between immortals and mortals.",
        "start": 29.12,
        "end": 35.131
      },
      {
        "scene": "S04",
        "text": "Zeus answered not with gratitude, but punishment.",
        "start": 36.3,
        "end": 39.34
      },
      {
        "scene": "S04",
        "text": "He ordered Prometheus chained to a remote rock, where a great eagle would tear at his liver.",
        "start": 40.16,
        "end": 46.22
      },
      {
        "scene": "S05",
        "text": "The wound renewed, and the torment returned.",
        "start": 47.36,
        "end": 50.14
      },
      {
        "scene": "S05",
        "text": "Each day the bird descended again.",
        "start": 50.14,
        "end": 52.86
      },
      {
        "scene": "S05",
        "text": "Yet the Titan remained the figure who had chosen suffering over obedience.",
        "start": 53.42,
        "end": 57.66
      },
      {
        "scene": "S06",
        "text": "His story leaves a question burning: when power withholds something essential, is taking it theft, or liberation?",
        "start": 59.22,
        "end": 66.94
      },
      {
        "scene": "S06",
        "text": "The flame still shines between them.",
        "start": 67.84,
        "end": 70.109
      }
    ],
